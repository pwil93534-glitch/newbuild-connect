# The Surprise Advantage — environment template.
# Copy to .env.local (git-ignored). NEVER commit real values. NEVER expose these to client-side code.
# All of these are SERVER-SIDE ONLY (Phase 2 serverless function).

HIGHLEVEL_API_KEY=            # HighLevel private integration token (owner to create; scope: contacts write, tags)
HIGHLEVEL_LOCATION_ID=        # HighLevel sub-account / location ID
HIGHLEVEL_PIPELINE_ID=        # optional
FORM_ALLOWED_ORIGIN=          # production site origin, e.g. https://<approved-domain>
FORM_RATE_LIMIT_PER_HOUR=10
SUPPRESSION_LIST_TAG=suppressed   # CRM tag that blocks all marketing
